{
  "name": "@verity-board/cli",
  "version": "0.1.0",
  "description": "The verity-board CLI — run an AI-assisted engineering review committee against a local case directory.",
  "license": "MIT",
  "author": "Balajikumar Murugan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ji-in-loop/verity-board.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "verity-board": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@verity-board/core": "workspace:*",
    "@verity-board/config": "workspace:*",
    "@verity-board/orchestrator": "workspace:*",
    "@verity-board/providers-evidence-local": "workspace:*",
    "@verity-board/providers-model-mock": "workspace:*",
    "@verity-board/providers-model-anthropic": "workspace:*",
    "@verity-board/providers-model-openai": "workspace:*",
    "@verity-board/providers-model-gemini": "workspace:*",
    "@verity-board/reporters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
