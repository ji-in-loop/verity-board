  "license": "MIT",
  "author": "Balajikumar Murugan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ji-in-loop/verity-board.git",
    "directory": "packages/providers-model-openai"
  },
  "type": "module",
  "main": "./dist/index.js",
